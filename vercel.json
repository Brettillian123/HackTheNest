{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "redirects": [
    { "source": "/home", "destination": "/", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/challenge", "destination": "/challenges.html" },
    { "source": "/api/:route*", "destination": "/api/index" },
    { "source": "/:page([A-Za-z0-9_-]+)", "destination": "/:page.html" }
  ]
}
