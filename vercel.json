{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "redirects": [
    { "source": "/", "destination": "/home", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/pages/home.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/signup", "destination": "/pages/signup.html" },
    { "source": "/challenge", "destination": "/pages/home.html" },
    { "source": "/api/:route*", "destination": "/api/index" },
    { "source": "/:page([A-Za-z0-9_-]+)", "destination": "/pages/:page.html" }
  ]
}
