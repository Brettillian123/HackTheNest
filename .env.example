# Copy this file to ".env" in the repo root and fill in the values. ".env" is git-ignored.
# This example file holds names only: never put a real key in it.
# "npm run dev" reads the root .env (node --env-file=.env).

# --- Database (the backend uses this now) ---
# MongoDB Atlas connection string (starts with mongodb+srv://)
MONGODB_URI=

# --- Models players prompt (each provider is enabled only when its key is set) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider model ids (defaults: gpt-6-luna, claude-haiku-5-5)
OPENAI_MODEL=
ANTHROPIC_MODEL=

# --- Grader service (grader/service/README.md). Without both, a provisional stand-in scorer is used ---
# Base URL of the grader service, e.g. http://<server-ip>:8080 (plain http works; keep the key server-side)
GRADER_URL=
# Same key the grader service was started with
GRADER_API_KEY=
# Optional: time budget per grade in milliseconds (default 45000, fits the 60 s function limit)
GRADER_TIMEOUT_MS=
# Optional: on | off. Send keyFacts as "intent" in page grade requests (default: auto, from the grader's /health)
GRADER_INTENT=
# Optional: on | off. Ask the grader (POST /v1/check/prompt) whether a page prompt copies the brief before a run (default: auto, from the grader's /health)
GRADER_PROMPT_CHECK=

# --- Content ---
# Optional: folder of lessons (default web/data/lessons)
LESSONS_DIR=

# --- Limits (all per UTC day) ---
# Prompt and output size limits are per challenge (maxPromptChars, maxOutputTokens in the challenge
# files; see backend/README.md "Limits and prompt safety"), not environment variables.
# Runs each player may make (default 30)
RUNS_PER_DAY=
# Runs from one IP address, signed in or not (default: 10 x RUNS_PER_DAY, for shared venue networks)
RUNS_PER_IP_PER_DAY=
# Runs across all players together, a ceiling on model spend (default 1500)
RUNS_PER_DAY_TOTAL=

# --- Payments: Stripe Checkout, TEST MODE ONLY (backend/README.md "Credits and payments") ---
# Stripe test secret key. Must start with sk_test_; any other key is refused and payments stay off.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<site>/api/billing/webhook,
# event checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Optional: site address for the Checkout return pages, e.g. https://promptdyno.vercel.app
# (default: https:// plus the request's host)
SITE_URL=
# Development and tests only: "off" removes the daily free-tier limit and credit charges
BILLING_LIMITS=
# Free-tier limits per network (IP) = per-player limits x this (default 50, minimum 1).
FREE_PER_IP_MULTIPLIER=

# --- Optional remote grader service (leave blank for local npm run dev) ---
GRADER_SERVICE_URL=
GRADER_SERVICE_TOKEN=

# --- Optional, only if these features get built ---
ELEVENLABS_API_KEY=
# Signs session cookies (any long random string). If empty, a key derived from MONGODB_URI is used.
AUTH_SECRET=
# GitHub sign-in through Auth.js. The app has its own email and password login today, so these are unused.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
