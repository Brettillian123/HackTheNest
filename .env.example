# Copy this file to ".env" in the repo root and fill in the values. ".env" is git-ignored.
# This example file holds names only: never put a real key in it.
# "npm run dev" reads the root .env (node --env-file=.env).

# --- Database (the backend uses this now) ---
# MongoDB Atlas connection string (starts with mongodb+srv://)
MONGODB_URI=

# --- Models players prompt (each provider is enabled only when its key is set) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider model ids (defaults: gpt-6-luna, gemini-3.8-flash, claude-haiku-5-5)
OPENAI_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=

# --- Grader service (grader/service/README.md). Without both, a provisional stand-in scorer is used ---
# Base URL of the grader service, e.g. http://<server-ip>:8080 (plain http works; keep the key server-side)
GRADER_URL=
# Same key the grader service was started with
GRADER_API_KEY=
# Optional: time budget per grade in milliseconds (default 45000, fits the 60 s function limit)
GRADER_TIMEOUT_MS=

# --- Content ---
# Optional: folder of lessons (default web/data/lessons)
LESSONS_DIR=

# --- Limits (all per UTC day) ---
# Runs each player may make (default 30)
RUNS_PER_DAY=
# Runs from one IP address, signed in or not (default: 10 x RUNS_PER_DAY, for shared venue networks)
RUNS_PER_IP_PER_DAY=
# Runs across all players together, a ceiling on model spend (default 1500)
RUNS_PER_DAY_TOTAL=

# --- Optional, only if these features get built ---
ELEVENLABS_API_KEY=
# Signs session cookies (any long random string). If empty, a key derived from MONGODB_URI is used.
AUTH_SECRET=
# GitHub sign-in through Auth.js. The app has its own email and password login today, so these are unused.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
