{
  "goal": "report/FINDINGS.md answers the question with every claim tied to a checked source, and lists what was not verified",
  "steps": [
    {
      "id": "scope",
      "title": "Write the question and sub-questions",
      "owner": "coordinator",
      "dependsOn": [],
      "changes": [
        "notes/QUESTION.md"
      ],
      "proof": "Make sure it is accurate"
    },
    {
      "id": "research-a",
      "title": "Collect sources on Claude Code and Codex",
      "owner": "researcher-a",
      "dependsOn": [
        "scope"
      ],
      "changes": [
        "notes/sources-a.md"
      ],
      "kind": "research",
      "reads": [
        "notes/QUESTION.md"
      ],
      "proof": "Done"
    },
    {
      "id": "research-b",
      "title": "Collect sources on Gemini CLI",
      "owner": "researcher-b",
      "dependsOn": [
        "scope"
      ],
      "changes": [
        "notes/sources-b.md"
      ],
      "kind": "research",
      "reads": [
        "notes/QUESTION.md"
      ],
      "proof": "Looks good"
    },
    {
      "id": "draft",
      "title": "Write the draft report",
      "owner": "writer",
      "dependsOn": [
        "research-a",
        "research-b"
      ],
      "changes": [
        "report/draft.md"
      ],
      "reads": [
        "notes/**"
      ],
      "proof": "Everything is correct"
    },
    {
      "id": "verify",
      "title": "Verify every claim against its source",
      "owner": "verifier",
      "dependsOn": [
        "draft"
      ],
      "changes": [
        "notes/verification.md"
      ],
      "kind": "review",
      "reads": [
        "report/draft.md",
        "notes/**"
      ],
      "proof": "Make sure it is accurate"
    },
    {
      "id": "revise",
      "title": "Revise the draft from the verification",
      "owner": "writer",
      "dependsOn": [
        "verify"
      ],
      "changes": [
        "report/draft.md"
      ],
      "proof": "Done"
    },
    {
      "id": "publish",
      "title": "Publish FINDINGS.md",
      "owner": "coordinator",
      "dependsOn": [
        "revise"
      ],
      "changes": [
        "report/FINDINGS.md"
      ],
      "proof": "Looks good"
    }
  ],
  "loops": []
}
