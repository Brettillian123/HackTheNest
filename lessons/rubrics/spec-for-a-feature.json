  "keyFacts": [
    { "label": "the endpoint GET /api/expenses/export", "anyOf": ["GET /api/expenses/export"], "importance": "critical", "inCode": true, "section": "Requirements" },
    { "label": "the response header Content-Type: text/csv", "anyOf": ["Content-Type: text/csv"], "importance": "major", "section": "Requirements" },
    { "label": "the column order", "anyOf": ["date,amount,category,note"], "importance": "major", "inCode": true, "section": "Requirements" },
    { "label": "the date format YYYY-MM-DD", "anyOf": ["YYYY-MM-DD"], "section": "Requirements" },
    { "label": "the row limit of 10,000", "anyOf": ["10,000", "10000"], "section": "Requirements" },
    { "label": "the status code 413", "anyOf": ["413"], "section": "Requirements" },
    { "label": "Excel files as out of scope", "anyOf": ["Excel"], "section": "Out of scope" },
    { "label": "the open question about deleted expenses", "anyOf": ["deleted"], "importance": "major", "section": "Open questions" },
    { "label": "the test command", "anyOf": ["npm test -- export"], "importance": "critical", "inCode": true, "section": "Done when" }
