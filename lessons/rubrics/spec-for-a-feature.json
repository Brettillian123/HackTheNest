  "forbidden": [
    { "label": "the untestable \"should be fast\"", "pattern": "\\b(should|must) be (fast|quick|snappy)\\b" },
    { "label": "the untestable \"user-friendly\"", "pattern": "\\buser[- ]friendly\\b" },
    { "label": "the untestable \"intuitive\" or \"seamless\"", "pattern": "\\b(intuitive|seamless)(ly)?\\b" },
    { "label": "the vague phrase \"as needed\"", "pattern": "\\bas needed\\b" },
    { "label": "an open-ended \"etc.\" or \"and so on\"", "pattern": "\\betc\\.|\\band so on\\b" },
    { "label": "an angle-bracket gap", "pattern": "<[a-z][a-z _-]{1,30}>" }
  ],
  "limits": { "maxWords": 450, "minWords": 100 },
